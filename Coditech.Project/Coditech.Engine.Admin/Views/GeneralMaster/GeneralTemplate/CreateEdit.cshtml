@model GeneralTemplateViewModel
@{
    ViewBag.Title = Model.GeneralTemplateMasterId > 0 ? "Update Template" : "Add Template";
    string controllerName = ViewContext.RouteData.Values["controller"].ToString();
    string actionName = ViewContext.RouteData.Values["action"].ToString();
    PageHeaderViewModel headerModel = new PageHeaderViewModel
            {
                Title = ViewBag.Title,
                SaveButtonText = GeneralResources.SaveButtonText,
                CancelUrl = Url.Action(AdminConstants.ActionRedirectToList, controllerName),
                CancelButtonText = GeneralResources.CancelButtonText,
                ControllerName = controllerName,
                ActionName = actionName,
                FormId = AdminConstants.FormId + controllerName,
            };
}
<!-- Page Content-->
<div class="page-content">
    <div class="container-fluid mt-5">
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        @using (Html.BeginForm(actionName, controllerName, FormMethod.Post, new { id = headerModel.FormId }))
                        {
                            @Html.Partial("~/Views/Shared/_SaveAndCloseButtonLayout.cshtml", headerModel)
                            @Html.HiddenFor(m => m.GeneralTemplateMasterId)
                            <div class="row">
                                <div class="col-lg-6">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.TemplateName, new { @class = "form-label required" })
                                        @Html.TextBoxFor(x => x.TemplateName, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(x => x.TemplateName)
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.TemplateCode, new { @class = "form-label required" })
                                        @if (Model.GeneralTemplateMasterId > 0)
                                        {
                                            @Html.TextBoxFor(x => x.TemplateCode, new { @class = "form-control", @readonly = "readonly" })
                                        }
                                        else
                                        {
                                            @Html.TextBoxFor(x => x.TemplateCode, new { @class = "form-control" })
                                        }
                                        @Html.ValidationMessageFor(x => x.TemplateCode)
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="mb-3">
                                        @Html.LabelFor(x => x.TemplateType, new { @class = "form-label required" })
                                        @Html.TextBoxFor(x => x.TemplateType, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(x => x.TemplateType)
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
